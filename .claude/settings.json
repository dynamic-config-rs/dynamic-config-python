{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo package:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo hack:*)",
      "Bash(cargo run:*)",
      "Bash(rustup:*)",
      "Bash(just:*)",
      "Bash(maturin:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m mypy:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(vermin:*)",
      "Bash(python examples/:*)",
      "Bash(pip install:*)",
      "Bash(pip show:*)",
      "Bash(python -m venv:*)",
      "Bash(uv:*)"
    ],
    "deny": [
      "Bash(cargo publish:*)",
      "Bash(cargo release:*)",
      "Bash(maturin upload:*)",
      "Bash(maturin publish:*)",
      "Bash(twine:*)",
      "Bash(git push:*)",
      "Read(./**/*.creds)",
      "Read(./**/key.txt)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/binding-drift.sh"
          }
        ]
      }
    ]
  }
}
