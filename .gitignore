# Build output. Unanchored, so a doctest that writes under its own crate's
# `target/` is covered too.
target/

# `cargo package` and `cargo publish` write here; the tarballs are
# artefacts of a release, not part of one.
**/*.crate

# Backtraces and profiler output.
*.profraw
perf.data*
flamegraph.svg

# Editors and desktop environments.
.vscode/
.idea/
*.swp
.DS_Store

# `cargo release` writes this while it works and removes it afterwards; a
# leftover means a run was interrupted.
Cargo.toml.orig

# The book's build output.
book/book/

# Written by the suites at run time — they create the directory and their
# own fixtures, so a checkout carries none of it.
/dynamic-config-server/tests/scratch/

# The wheels' build and tool output.
dist/
build/
wheels/
*.egg-info/
*.egg
*.so
*.pyd
*.py[cod]
**/__pycache__/

# Virtual environments, named every way people name them.
.venv/
venv/
env/
.env/
ENV/

# Tool caches and reports
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.benchmarks/
